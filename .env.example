DATABASE_URL=postgres://paperboy@127.0.0.1:5433/paperboy
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3000
PAPERBOY_PUBLIC_URL=http://localhost:3000
PAPERBOY_LIVE_RATE_LIMIT_PER_MINUTE=60
PAPERBOY_TEST_RATE_LIMIT_PER_MINUTE=600
PAPERBOY_SPF_RECORD="v=spf1 mx ~all"
PAPERBOY_DKIM_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
PAPERBOY_WEBHOOK_ENCRYPTION_KEY=replace-with-different-base64-encoded-32-byte-key
PAPERBOY_UNSUBSCRIBE_SIGNING_KEY=replace-with-another-base64-encoded-32-byte-key
# Optional self-hosted SMTP return path for Postfix DSN ingestion.
# PAPERBOY_BOUNCE_ADDRESS=paperboy-bounce@bounces.example.com
# Postfix hook uses this protected file instead of a command-line secret.
# PAPERBOY_FEEDBACK_API_KEY_FILE=/run/secrets/paperboy_feedback_api_key
PAPERBOY_ATTACHMENT_STORAGE_PATH=/var/lib/paperboy/attachments
PAPERBOY_WORKER_POLL_MS=1000
# Local Mailpit only. Production omits SMTP_TLS_MODE to require STARTTLS.
SMTP_URL=smtp://127.0.0.1:1025
SMTP_TLS_MODE=disabled
TZ=UTC
