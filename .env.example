DATABASE_URL=postgres://paperboy@127.0.0.1:5433/paperboy
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3000
PAPERBOY_SPF_RECORD="v=spf1 mx ~all"
PAPERBOY_DKIM_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
PAPERBOY_ATTACHMENT_STORAGE_PATH=/var/lib/paperboy/attachments
PAPERBOY_WORKER_POLL_MS=1000
# Local Mailpit only. Production omits SMTP_TLS_MODE to require STARTTLS.
SMTP_URL=smtp://127.0.0.1:1025
SMTP_TLS_MODE=disabled
TZ=UTC
