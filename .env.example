DATABASE_URL=postgres://paperboy@127.0.0.1:5433/paperboy
REDIS_URL=redis://127.0.0.1:6379
# The web image defaults to web. Set jobs on the separate BullMQ deployment.
# PAPERBOY_PROCESS_TYPE=jobs
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3000
PAPERBOY_PUBLIC_URL=http://localhost:3000
PAPERBOY_PUBLIC_SIGNUP_ENABLED=false
PAPERBOY_LIVE_RATE_LIMIT_PER_MINUTE=60
PAPERBOY_TEST_RATE_LIMIT_PER_MINUTE=600
PAPERBOY_SPF_RECORD="v=spf1 mx ~all"
PAPERBOY_DKIM_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
PAPERBOY_WEBHOOK_ENCRYPTION_KEY=replace-with-different-base64-encoded-32-byte-key
PAPERBOY_UNSUBSCRIBE_SIGNING_KEY=replace-with-another-base64-encoded-32-byte-key
PAPERBOY_OPEN_TRACKING_SIGNING_KEY=replace-with-dedicated-base64-encoded-32-byte-key
# Optional self-hosted SMTP return path for Postfix DSN ingestion.
# PAPERBOY_BOUNCE_ADDRESS=paperboy-bounce@bounces.example.com
# Postfix hook uses this protected file instead of a command-line secret.
# PAPERBOY_FEEDBACK_API_KEY_FILE=/run/secrets/paperboy_feedback_api_key
# Local development storage. Production may set the driver to s3 instead.
PAPERBOY_ATTACHMENT_STORAGE_DRIVER=local
PAPERBOY_ATTACHMENT_STORAGE_PATH=/var/lib/paperboy/attachments
# PAPERBOY_ATTACHMENT_S3_BUCKET=paperboy-private-attachments
# PAPERBOY_ATTACHMENT_S3_REGION=ap-southeast-2
# PAPERBOY_ATTACHMENT_S3_PREFIX=attachments
# Jobs poll SES inbound objects from this private bucket and delete them after
# a unique live organization matches a recipient domain. Omit to disable.
# PAPERBOY_INBOUND_S3_BUCKET=paperboy-inbound
# PAPERBOY_INBOUND_S3_REGION=ap-northeast-1
# PAPERBOY_INBOUND_S3_PREFIX=inbound
# BullMQ dispatch and reconciliation. Redis must use persistent storage and
# maxmemory-policy=noeviction.
PAPERBOY_QUEUE_PREFIX=paperboy
PAPERBOY_JOB_RECONCILE_MS=5000
PAPERBOY_JOB_RECONCILE_LIMIT=250
PAPERBOY_MESSAGE_JOB_CONCURRENCY=5
PAPERBOY_BROADCAST_JOB_CONCURRENCY=1
PAPERBOY_WEBHOOK_JOB_CONCURRENCY=5
# Local Mailpit only. Production omits SMTP_TLS_MODE to require STARTTLS.
SMTP_URL=smtp://127.0.0.1:1025
SMTP_TLS_MODE=disabled
# Optional distinct Cloudflare Email Service operator default. Keep tokens in
# deployment secrets, not this file. Per-organisation names append the
# uppercased organisation UUID with dashes replaced by underscores.
# CLOUDFLARE_EMAIL_SMTP_URL=smtps://api_token:<URL-encoded-token>@smtp.mx.cloudflare.net:465
# PAPERBOY_SMTP_URL_<NORMALIZED_ORGANIZATION_UUID>=smtps://user:<password>@smtp.example.com:465
# PAPERBOY_CLOUDFLARE_EMAIL_SMTP_URL_<NORMALIZED_ORGANIZATION_UUID>=smtps://api_token:<URL-encoded-token>@smtp.mx.cloudflare.net:465
# Optional Amazon SES v2 operator default. Keep IAM/access credentials in the
# deployment secret store. Prefer a narrowly scoped role; set the exact SNS
# topic ARN only when the signed public SNS callback is enabled.
# AWS_SES_REGION=ap-southeast-2
# AWS_SES_CONFIGURATION_SET=paperboy-events
# AWS_SES_SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-2:123456789012:paperboy-ses-events
# AWS_SES_ROLE_ARN=arn:aws:iam::123456789012:role/paperboy-ses
# AWS_SES_EXTERNAL_ID=<operator-generated-external-id>
# AWS_SES_ACCESS_KEY_ID=<secret-store-value>
# AWS_SES_SECRET_ACCESS_KEY=<secret-store-value>
# AWS_SES_SESSION_TOKEN=<optional-secret-store-value>
# AWS_SES_USE_DEFAULT_CREDENTIAL_CHAIN=true
# Per-organisation SES names use PAPERBOY_AWS_SES_<FIELD>_<NORMALIZED_ORGANIZATION_UUID>.
PAPERBOY_DEFAULT_TIME_ZONE=Australia/Sydney
# Set both to the external HTTPS hostname before enrolling passkeys.
# PAPERBOY_PASSKEY_ORIGIN=https://paperboy.example.com
# PAPERBOY_PASSKEY_RP_ID=paperboy.example.com
TZ=Australia/Sydney
