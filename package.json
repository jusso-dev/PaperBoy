{
  "name": "paperboy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "mcp:stdio": "tsx src/mcp/stdio.ts",
    "openapi:lint": "redocly lint openapi.yaml",
    "sdk:build": "tsc -p packages/sdk/tsconfig.json",
    "worker": "tsx src/worker.ts",
    "test": "tsx --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "feedback:ingest": "tsx src/feedback-ingest.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.1",
    "@modelcontextprotocol/server": "2.0.0",
    "better-auth": "1.7.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "mailauth": "5.0.2",
    "mailparser": "3.9.15",
    "next": "^16.3.2",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "4.23.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@redocly/cli": "2.47.0",
    "@types/mailparser": "3.4.6",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.3.2",
    "typescript": "^5.9.2"
  }
}
