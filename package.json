{
  "name": "paperboy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint .",
    "mcp:stdio": "bun src/mcp/stdio.ts",
    "openapi:lint": "redocly lint openapi.yaml",
    "security:secrets": "./scripts/run-gitleaks.sh git --redact --verbose .",
    "sdk:build": "tsc -p packages/sdk/tsconfig.json",
    "sdk:generate": "./scripts/generate-sdks.sh",
    "jobs": "bun src/jobs.ts",
    "test": "bun test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/migrate.ts",
    "db:check": "drizzle-kit check",
    "feedback:ingest": "bun src/feedback-ingest.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/client-sesv2": "^3.1116.0",
    "@aws-sdk/credential-providers": "^3.1116.0",
    "@better-auth/drizzle-adapter": "1.7.1",
    "@better-auth/passkey": "1.7.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "better-auth": "1.7.1",
    "bullmq": "6.2.0",
    "chrono-node": "2.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.34.0",
    "mailauth": "5.0.2",
    "mailparser": "3.9.15",
    "next": "16.3.3",
    "nodemailer": "9.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-qr-code": "2.2.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@redocly/cli": "2.47.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "1.4.0",
    "@types/mailparser": "3.4.6",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "8.0.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  }
}
